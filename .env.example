# ══════════════════════════════════════════════════════════════════════════════
# Variables de entorno — Peluquería RM
# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas .env al repositorio (está en .gitignore).
# ══════════════════════════════════════════════════════════════════════════════

# ── NO SECRETAS: pueden declararse en render.yaml ────────────────────────────

# Entorno: development | production
ENVIRONMENT=development

# CORS — formato JSON array. En producción usar los dominios reales.
ALLOWED_ORIGINS=["http://localhost:5173"]
# Producción: ["https://rmolinastyle.com","https://www.rmolinastyle.com"]

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
RETENCION_MESES=24

# ── SECRETAS: introducir a mano en el panel de Render (nunca en render.yaml) ─

# Base de datos PostgreSQL.
# Local: usar postgresql+psycopg:// (psycopg3). Render inyecta postgres://
# y config.py lo normaliza automáticamente a postgresql+psycopg://.
DATABASE_URL=postgresql+psycopg://peluqueria:dev_local_2024@localhost:5432/peluqueria

# JWT — generar con: openssl rand -hex 32
# En Render usar generateValue: true (se genera automáticamente).
SECRET_KEY=cambia-esto-por-un-secreto-largo-y-aleatorio

# Cuentas de administrador — solo las usa seed.py, no el servidor en runtime.
# ADMIN1_PASSWORD / ADMIN2_PASSWORD solo se usan al crear el admin (primer deploy).
# En deploys posteriores, seed.py verifica el rol pero NO toca la contraseña.
ADMIN1_EMAIL=admin@rmolinastyle.com
ADMIN1_PASSWORD=cambia-esto-contrasena-fuerte-admin1
ADMIN1_NOMBRE=Nombre Desarrollador
ADMIN1_TELEFONO=600000001

ADMIN2_EMAIL=peluquero@rmolinastyle.com
ADMIN2_PASSWORD=cambia-esto-contrasena-fuerte-admin2
ADMIN2_NOMBRE=Nombre del Peluquero
ADMIN2_TELEFONO=600000002

# Telegram — crear bot con @BotFather, obtener chat_id con /getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
