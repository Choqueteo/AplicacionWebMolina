# ── Base de datos ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://usuario:contraseña@localhost:5432/nombre_bd

# ── JWT ────────────────────────────────────────────────────────────────────────
SECRET_KEY=cambiame-usa-openssl-rand-hex-32
ALGORITHM=HS256
# Duración del JWT: 60 * 24 * 7 = 7 días
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── CORS (formato JSON array) ──────────────────────────────────────────────────
ALLOWED_ORIGINS=["https://tu-frontend.onrender.com"]

# ── Entorno ────────────────────────────────────────────────────────────────────
ENVIRONMENT=production

# ── Admins (seed.py) ───────────────────────────────────────────────────────────
# Ejecutar: cd backend && venv/Scripts/python seed.py
# En producción usar contraseñas FUERTES (mínimo 16 chars, mayús/minús/números/símbolos)
ADMIN1_EMAIL=admin@tudominio.com
ADMIN1_PASSWORD=cambiame-contrasena-fuerte
ADMIN1_NOMBRE=Nombre Apellido
ADMIN1_TELEFONO=600000000

ADMIN2_EMAIL=peluquero@tudominio.com
ADMIN2_PASSWORD=cambiame-contrasena-fuerte
ADMIN2_NOMBRE=Nombre Apellido
ADMIN2_TELEFONO=600000000

# ── Notificaciones Telegram ─────────────────────────────────────────────────
# Crear bot con @BotFather → obtener TELEGRAM_BOT_TOKEN
# Enviar un mensaje al bot y abrir api.telegram.org/bot<TOKEN>/getUpdates → chat.id
TELEGRAM_BOT_TOKEN=cambiame-token-del-bot
TELEGRAM_CHAT_ID=cambiame-chat-id-del-peluquero
